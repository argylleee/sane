{
  "name": "appbuilder-hackathon",
  "version": "0.0.0",
  "private": true,
  "description": "Stack-neutral preparation for a 24-hour hackathon",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "format": "prettier --write .",
    "format:files": "prettier --write --ignore-unknown",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/lint-markdown.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:task": "node scripts/check-task.mjs",
    "check:git": "node scripts/check-git.mjs",
    "role:session": "node scripts/role-session.mjs",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "vendor:record": "node scripts/record-vendor.mjs",
    "skills:export": "node scripts/export-skills.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "markdownlint": "0.41.1",
    "prettier": "3.9.9",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "0.19.0"
  }
}
